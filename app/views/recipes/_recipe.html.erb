<div id="<%= dom_id recipe %>">
  <div>
    <strong>Name:</strong>
    <%= recipe.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= recipe.description %>
  </div>

  <div>
    <strong>Image:</strong>
    <%= recipe.image %>
  </div>

  <div>
    <strong>Total views:</strong>
    <%= recipe.total_views %>
  </div>

  <div>
    <strong>Weekly views:</strong>
    <%= recipe.weekly_views %>
  </div>

  <div>
    <strong>Total scores:</strong>
    <%= recipe.total_scores %>
  </div>

  <div>
    <strong>Score:</strong>
    <%= recipe.score %>
  </div>

</div>
