<div id="<%= dom_id item %>">
  <div>
    <strong>Ingredient:</strong>
    <%= item.ingredient_id %>
  </div>

  <div>
    <strong>Recipe:</strong>
    <%= item.recipe_id %>
  </div>

  <div>
    <strong>Quantity:</strong>
    <%= item.quantity %>
  </div>

  <div>
    <strong>Price:</strong>
    <%= item.price %>
  </div>

</div>
