<%= form_with(model: item) do |form| %>
  <% if item.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(item.errors.count, "error") %> prohibited this item from being saved:</h2>

      <ul>
        <% item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :ingredient_id, style: "display: block" %>
    <%= form.collection_select :ingredient_id, Ingredient.all, :id, :name, prompt: "Select an ingredient" %>
  </div>

  <div>
    <%= form.label :recipe_id, style: "display: block" %>
    <%= form.collection_select :recipe_id,Recipe.all, :id, :name, prompt: "Select a recipe" %>
  </div>

  <div>
    <%= form.label :quantity, style: "display: block" %>
    <%= form.text_field :quantity %>
  </div>


  <div>
    <%= form.submit %>
  </div>
<% end %>
